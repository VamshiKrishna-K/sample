
INF = 99999

def printPath(parent, v):
    if v == -1:
        return

    printPath(parent, parent[v])
    print(v, end=" ")


n = int(input("Enter number of vertices: "))

cost = []

print("Enter adjacency matrix (0 if no edge):")

for i in range(n):
    row = list(map(int, input().split()))
    cost.append(row)

src = int(input(f"Enter source vertex (0 to {n-1}): "))

dist = [INF] * n
visited = [0] * n
parent = [-1] * n

dist[src] = 0

for count in range(n - 1):
    u = -1
    minDist = INF

    for i in range(n):
        if not visited[i] and dist[i] < minDist:
            minDist = dist[i]
            u = i

    if u == -1:
        break

    visited[u] = 1

    for j in range(n):
        if (not visited[j] and cost[u][j] != 0
            and dist[u] != INF
            and dist[u] + cost[u][j] < dist[j]):

            dist[j] = dist[u] + cost[u][j]
            parent[j] = u


print(f"\nShortest distances from source {src}:")

for i in range(n):
    print(f"To {i}: ", end="")

    if dist[i] == INF:
        print("Unreachable")
    else:
        print(dist[i], end="\tPath: ")
        printPath(parent, i)
        print()
