#include <bits/stdc++.h>
using namespace std;

string checkCRC(string data, string divisor)
{
    // Degree of polynomial
    int n = divisor.size() - 1;

    // XOR division
    for (int i = 0; i <= data.size() - divisor.size(); i++)
    {
        if (data[i] == '1')
        {
            for (int j = 0; j < divisor.size(); j++)
            {
                data[i + j] =
                    (data[i + j] == divisor[j]) ? '0' : '1';
            }
        }
    }

    // Get remainder
    return data.substr(data.size() - n);
}

int main()
{
    string data;

    cout << "Enter transmitted code: ";
    cin >> data;

    string crc12 = "1100000001111";
    string crc16 = "11000000000000101";
    string ccitt = "10001000000100001";

    cout << "\n========== CRC-12 ==========\n";

    string r = checkCRC(data, crc12);

    cout << "Remainder: " << r << endl;

    if (r.find('1') == string::npos)
        cout << "Data is CORRECT\n";
    else
        cout << "Data is CORRUPTED\n";


    cout << "\n========== CRC-16 ==========\n";

    r = checkCRC(data, crc16);

    cout << "Remainder: " << r << endl;

    if (r.find('1') == string::npos)
        cout << "Data is CORRECT\n";
    else
        cout << "Data is CORRUPTED\n";


    cout << "\n========== CRC-CCITT ==========\n";

    r = checkCRC(data, ccitt);

    cout << "Remainder: " << r << endl;

    if (r.find('1') == string::npos)
        cout << "Data is CORRECT\n";
    else
        cout << "Data is CORRUPTED\n";

    return 0;
}
