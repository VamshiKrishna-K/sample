def crc_check(codeword, polynomial):
    dividend = list(codeword)
    poly = list(polynomial)
    degree = len(polynomial) - 1

    # Perform modulo-2 division
    for i in range(len(codeword) - degree):
        if dividend[i] == '1':
            for j in range(len(poly)):
                dividend[i + j] = str(int(dividend[i + j]) ^ int(poly[j]) )

    # Extract remainder
    remainder = ''.join(dividend[-degree:])

    return remainder


# Input generator polynomial
polynomial = input("Enter the generator polynomial: ")

# Input received codeword
codeword = input("Enter the received codeword: ")

remainder = crc_check(codeword, polynomial)

print("\nGenerator Polynomial:", polynomial)
print("Received Codeword:", codeword)
print("Remainder:", remainder)

if '1' not in remainder:
    print("Result: No Error Detected")
else:
    print("Result: Error Detected")
